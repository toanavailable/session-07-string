<mxfile><diagram name="Mindmap"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="root" value="Python Session 7&lt;br&gt;String (Chuỗi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3a5f;fontColor=#ffffff;strokeColor=#1f3a5f;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="961" y="845" width="224" height="72" as="geometry"/></mxCell><mxCell id="l0" value="01. Tổng quan về string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1211" y="623" width="206" height="36" as="geometry"/></mxCell><mxCell id="el0" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=3;" edge="1" parent="1" source="root" target="l0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_0" value="Chuỗi ký tự trong &#x27;...&#x27; hoặc &quot;...&quot;; nhiều dòng: &quot;&quot;&quot;...&quot;&quot;&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1749" y="750" width="375" height="36" as="geometry"/></mxCell><mxCell id="el0_0" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="l0" target="l0_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_1" value="Chỉ số dương từ 0 (trái → phải)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1763" y="530" width="230" height="36" as="geometry"/></mxCell><mxCell id="el0_1" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="l0" target="l0_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_2" value="Chỉ số âm từ -1 (ký tự cuối, phải → trái)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1620" y="333" width="288" height="36" as="geometry"/></mxC