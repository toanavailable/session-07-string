ấy start → stop-1 (Exclusive Stop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="733" y="0" width="344" height="36" as="geometry"/></mxCell><mxCell id="el1_0" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="l1" target="l1_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1_1" value="Bỏ trống: s[:3] đầu chuỗi, s[3:] đến cuối" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="568" y="59" width="293" height="36" as="geometry"/></mxCell><mxCell id="el1_1" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="l1" target="l1_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1_2" value="s[start:stop:step]; s[::-1] đảo ngược chuỗi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="392" y="172" width="303" height="36" as="geometry"/></mxCell><mxCell id="el1_2" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="l1" target="l1_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1_3" value="+ nối chuỗi; * lặp chuỗi (&quot;-&quot; * 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="258" y="333" width="248" height="36" as="geometry"/></mxCell><mxCell id="el1_3" style="endArrow=none;curved=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="l1" target="l1_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1_4" value="in / not in: kiểm tra chuỗi con" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="157" y="530" width="224" height="36" as="geometry"/></mxCell><mxCell id="el1_4" style="end